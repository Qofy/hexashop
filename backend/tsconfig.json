{
  "compilerOptions": {
    // ===== Output Settings =====
    "target": "ES2020",                    // JavaScript version to compile to (modern)
    "module": "commonjs",                  // Module format (Node.js standard)
    "lib": ["ES2020"],                     // Include ES2020 library features
    "outDir": "./dist",                    // Where compiled JS files go
    "rootDir": "./src",                    // Where your TypeScript source files are
    
    // ===== Module Resolution =====
    "moduleResolution": "node",            // Use Node.js module resolution
    "baseUrl": "./",                       // Base directory for imports
    "paths": {
      "@/*": ["src/*"]                     // Allow @/ imports (example: @/services/authService)
    },
    
    // ===== Strict Type Checking =====
    "strict": true,                        // Enable all strict type checking options
    "esModuleInterop": true,               // Allow default imports from CommonJS modules
    "skipLibCheck": true,                  // Skip type checking of declaration files
    "forceConsistentCasingInFileNames": true,  // File names must match case
    "resolveJsonModule": true,             // Allow importing JSON files
    
    // ===== Emit Settings =====
    "declaration": true,                   // Generate .d.ts files
    "declarationMap": true,                // Generate source maps for .d.ts files
    "sourceMap": true,                     // Generate .map files for debugging
    "removeComments": true                 // Remove comments from compiled JS
  },
  
  "include": ["src/**/*"],                 // Include all files in src folder
  "exclude": ["node_modules", "dist"]     // Exclude these folders
}
